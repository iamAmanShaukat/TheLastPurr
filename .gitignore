```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/

# Logs
*.log

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*.swp
*~

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Testing
.mypy_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
.env/

# Gradle
.gradle/
build/

# Go (if applicable)
bin/
*.exe
*.dll
*.so
*.dylib

# Rust (if applicable)
target/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```