```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python cache (if any Python files exist in client)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
.DS_Store
Thumbs.db

# Testing
.nyc_output/
coverage/lcov-report/

# TypeScript/JavaScript specific
.next/
.nuxt/
public/dist/
```